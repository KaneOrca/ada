/* Ada KOC 共用样式：只求清楚可用（spec §4）。 */
page {
  background: #f6f6f6;
  color: #222;
  font-size: 30rpx;
}

.page {
  padding: 32rpx;
  box-sizing: border-box;
}

.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding-top: 160rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-weight: 600;
}

.card.selected {
  outline: 4rpx solid #07c160;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.hint {
  color: #888;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.muted {
  color: #999;
  font-size: 22rpx;
  word-break: break-all;
}

.error {
  color: #c0392b;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eee;
  color: #555;
  flex-shrink: 0;
}

.badge-rework,
.badge-rejected {
  background: #fdecea;
  color: #c0392b;
}

.badge-deliverable,
.badge-approved {
  background: #e7f7ee;
  color: #07a650;
}

.segment {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.segment-tag {
  color: #888;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

textarea.editor {
  width: 100%;
  min-height: 120rpx;
  background: #fafafa;
  border-radius: 8rpx;
  padding: 12rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
}
